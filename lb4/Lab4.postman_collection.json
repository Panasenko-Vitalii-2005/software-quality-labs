  "item": [
    {
      "name": "01 GET with Params",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type is JSON\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
              "        .to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains name parameter\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.args.name).to.eql(\"Vitalii\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains role parameter\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.args.role).to.eql(\"student\");\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/get?name=Vitalii&role=student",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "get"
          ],
          "query": [
            {
              "key": "name",
              "value": "Vitalii"
            },
            {
              "key": "role",
              "value": "student"
            }
          ]
        }
      },
